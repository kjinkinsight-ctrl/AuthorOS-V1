{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiauthors.com/schemas/authoros-archive-manifest-v1.schema.json",
  "title": "AuthorOS Archive Manifest Version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archiveFormat",
    "archiveVersion",
    "archiveId",
    "createdAt",
    "createdBy",
    "contentScope",
    "rootIds",
    "schemaVersions",
    "entries",
    "contentFingerprint"
  ],
  "properties": {
    "archiveFormat": {
      "const": "authoros"
    },
    "archiveVersion": {
      "const": 1
    },
    "archiveId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "$ref": "#/$defs/createdBy"
    },
    "contentScope": {
      "enum": ["project", "series", "universe", "library-selection"]
    },
    "rootIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "schemaVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "contentFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "sourceInstallationHash": {
      "$ref": "#/$defs/sha256"
    },
    "extensionData": {
      "type": "object"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "version", "platform"],
      "properties": {
        "application": {
          "const": "AuthorOS"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "build": {
          "type": "string",
          "maxLength": 100
        },
        "platform": {
          "enum": ["windows", "android", "macos", "ios", "linux", "web", "unknown"]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "mediaType", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(data|content|assets|reports)/[A-Za-z0-9._/-]+$"
        },
        "role": {
          "enum": [
            "scopes",
            "record-types",
            "records",
            "links",
            "manuscripts",
            "manuscript-nodes",
            "studio-views",
            "writing-sessions",
            "scene-content",
            "note-content",
            "asset",
            "migration-report",
            "unresolved-references"
          ]
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "assetId": {
          "$ref": "#/$defs/stableId"
        },
        "extensionData": {
          "type": "object"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFormat", "reportPath", "warningCount", "unresolvedReferenceCount"],
      "properties": {
        "sourceFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceVersion": {
          "type": "string",
          "maxLength": 100
        },
        "reportPath": {
          "const": "reports/migration.json"
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedReferenceCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}