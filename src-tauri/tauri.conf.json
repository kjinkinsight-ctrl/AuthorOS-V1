{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Author Studio",
  "version": "1.0.0",
  "identifier": "com.authorstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist",
    "additionalWatchFolders": [
      "../index.html",
      "../assets",
      "../css",
      "../js"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Author Studio",
        "width": 1500,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "maximizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Author Studio",
    "shortDescription": "Author Studio for desktop.",
    "longDescription": "Author Studio is an offline-first writing workspace for projects, chapters, characters, worldbuilding, notes, backups, and manuscript exports.",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Author Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Author Studio",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "branding/nsis-header.bmp",
        "sidebarImage": "branding/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "branding/wix-banner.bmp",
        "dialogImagePath": "branding/wix-dialog.bmp"
      }
    }
  }
}
